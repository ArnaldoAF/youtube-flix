{
  "name": "youtube-flix",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["server", "client"],
  "scripts": {
    "dev": "concurrently -n server,client -c red,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "export-catalog": "npm run export-catalog -w server --",
    "import-catalog": "npm run import-catalog -w server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
